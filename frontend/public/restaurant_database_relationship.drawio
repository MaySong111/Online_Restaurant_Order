        <mxCell id="e0Ij0Am89Iqi9RzZNNME-104" value="OrderItem (nav)" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;" vertex="1" parent="e0Ij0Am89Iqi9RzZNNME-102">
          <mxGeometry x="40" width="180" height="30" as="geometry">
            <mxRectangle width="180" height="30" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e0Ij0Am89Iqi9RzZNNME-105" value="* ItemName and Price are stored directly on OrderItem&lt;div&gt;&amp;nbsp;(snapshot at order time).&amp;nbsp;&lt;div&gt;Even if MenuItem is later deleted or updated,&lt;/div&gt;&lt;div&gt;&amp;nbsp;the order history remains accurate.&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=#ffffcc;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="320" y="390" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e0Ij0Am89Iqi9RzZNNME-106" value="Design Decision: Review → OrderItem (not MenuItem directly). This ensures only customers&amp;nbsp;&lt;div&gt;who actually purchased an item can leave a review. Rating display on MenuItem is calculated&amp;nbsp;&lt;/div&gt;&lt;div&gt;as the average of all Reviews linked via OrderItem.MenuItemId.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=#f9dbc8;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="970" y="370" width="470" height="70" as="geometry" />
        </mxCell>
